# Copy this file to .env beside pom.xml. Replace example values locally.
# Do not commit .env or put credentials in IntelliJ Environment variables.
DB_URL=jdbc:mysql://localhost:3306/online_learning_new?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# JwtTokenProvider hashes this string; Base64 input is not required.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GMAIL_USERNAME=your-sending-account@gmail.com
GMAIL_APP_PASSWORD=replace-with-app-password-without-spaces
MAIL_FROM=your-sending-account@gmail.com

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: uncomment to override the project's current Google Web Client ID.
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Online@123

# Required for upload features. Use real Cloudinary account values locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=online-learning

AUTH_VERIFICATION_TOKEN_HOURS=24
AUTH_RESET_TOKEN_MINUTES=15
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=30

# SePay and ngrok: copy and fill their separate *-local.properties.example files.
# Upload limits are currently defined in application.yaml (100MB / 101MB).
